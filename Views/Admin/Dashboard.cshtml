@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-5">

    <div class="text-center mb-5">
        <h1>Admin Dashboard</h1>

        <p class="text-muted">
            Manage and monitor the Local Job Portal.
        </p>
    </div>

    <div class="row g-4">

        <!-- Employers -->
        <div class="col-md-6 col-lg-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        Employers
                    </h4>

                    <p class="card-text">
                        View registered employers
                        and their company information.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="ViewEmployers"
                       class="btn btn-primary">
                        View Employers
                    </a>

                </div>

            </div>

        </div>


        <!-- Job Seekers -->
        <div class="col-md-6 col-lg-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        Job Seekers
                    </h4>

                    <p class="card-text">
                        View registered job seekers
                        and their profiles.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="ViewJobSeekers"
                       class="btn btn-primary">
                        View Job Seekers
                    </a>

                </div>

            </div>

        </div>


        <!-- Jobs -->
        <div class="col-md-6 col-lg-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        Jobs
                    </h4>

                    <p class="card-text">
                        View and manage jobs posted
                        by employers.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="ManageJobs"
                       class="btn btn-success">
                        Manage Jobs
                    </a>

                </div>

            </div>

        </div>


        <!-- Applications -->
        <div class="col-md-6 col-lg-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        Applications
                    </h4>

                    <p class="card-text">
                        View job applications
                        submitted by job seekers.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="ViewApplications"
                       class="btn btn-info">
                        View Applications
                    </a>

                </div>

            </div>

        </div>


        <!-- Logout -->
        <div class="col-md-6 col-lg-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        Logout
                    </h4>

                    <p class="card-text">
                        Sign out from the admin account.
                    </p>

                    <a asp-controller="Admin"
                       asp-action="Logout"
                       class="btn btn-danger">
                        Logout
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>