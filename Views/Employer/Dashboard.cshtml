@{
    ViewData["Title"] = "Employer Dashboard";
}

<div class="container mt-5">

    <div class="text-center mb-5">
        <h1>Employer Dashboard</h1>
        <p class="text-muted">
            Manage your company, jobs and applicants.
        </p>
    </div>

    <div class="row g-4">

        <!-- Company Profile -->
        <div class="col-md-6 col-lg-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        Company Profile
                    </h4>

                    <p class="card-text">
                        View and update your company information.
                    </p>

                    <a asp-controller="Employer"
                       asp-action="Profile"
                       class="btn btn-primary">
                        My Profile
                    </a>

                </div>

            </div>

        </div>

        <!-- Post Job -->
        <div class="col-md-6 col-lg-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        Post a Job
                    </h4>

                    <p class="card-text">
                        Create a new job opportunity.
                    </p>

                    <a asp-controller="Employer"
                       asp-action="PostJob"
                       class="btn btn-success">
                        Post Job
                    </a>

                </div>

            </div>

        </div>

        <!-- Manage Jobs -->
        <div class="col-md-6 col-lg-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        Manage Jobs
                    </h4>

                    <p class="card-text">
                        Edit, delete and close your posted jobs.
                    </p>

                    <a asp-controller="Employer"
                       asp-action="ManageJobs"
                       class="btn btn-primary">
                        Manage Jobs
                    </a>

                </div>

            </div>

        </div>

        <!-- View Applicants -->
        <div class="col-md-6 col-lg-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        View Applicants
                    </h4>

                    <p class="card-text">
                        View candidates who applied for your jobs.
                    </p>

                    <a asp-controller="Employer"
                       asp-action="ViewApplicants"
                       class="btn btn-info">
                        View Applicants
                    </a>

                </div>

            </div>

        </div>

        <!-- Logout -->
        <div class="col-md-6 col-lg-4">

            <div class="card shadow h-100">

                <div class="card-body text-center">

                    <h4 class="card-title">
                        Logout
                    </h4>

                    <p class="card-text">
                        Sign out from the employer account.
                    </p>

                    <a asp-controller="Employer"
                       asp-action="Logout"
                       class="btn btn-danger">
                        Logout
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>