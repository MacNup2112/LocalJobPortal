@model IEnumerable<LocalJobPortal.Models.ManageJobViewModel>

@{
    ViewData["Title"] = "Manage Jobs";
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Manage Jobs</h2>
            <p class="text-muted">
                View and manage your posted jobs.
            </p>
        </div>

        <a asp-controller="Employer"
           asp-action="PostJob"
           class="btn btn-success">
            + Post New Job
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["SuccessMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["ErrorMessage"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You have not posted any jobs yet.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var job in Model)
            {
                <div class="col-md-6 mb-4">

                    <div class="card shadow h-100">

                        <div class="card-header bg-success text-white">
                            <h4 class="mb-0">
                                @job.JobTitle
                            </h4>
                        </div>

                        <div class="card-body">

                            <p>
                                <strong>Location:</strong>
                                @job.Location
                            </p>

                            <p>
                                <strong>Job Type:</strong>
                                @job.JobType
                            </p>

                            <p>
                                <strong>Salary:</strong>
                                @job.Salary
                            </p>

                            <p>
                                <strong>Required Skills:</strong>
                                @job.RequiredSkills
                            </p>

                            <hr />

                            <h5 class="mb-3">Vacancy Details</h5>

                            <div class="row text-center mb-3">

                                <div class="col-4">
                                    <div class="border rounded p-2 h-100">
                                        <h4 class="text-primary">
                                            @job.TotalVacancies
                                        </h4>
                                        <small>Total Vacancies</small>
                                    </div>
                                </div>

                                <div class="col-4">
                                    <div class="border rounded p-2 h-100">
                                        <h4 class="text-warning">
                                            @job.FilledVacancies
                                        </h4>
                                        <small>Filled Vacancies</small>
                                    </div>
                                </div>

                                <div class="col-4">
                                    <div class="border rounded p-2 h-100">
                                        <h4 class="@(job.RemainingVacancies > 0 ? "text-success" : "text-danger")">
                                            @job.RemainingVacancies
                                        </h4>
                                        <small>Remaining Vacancies</small>
                                    </div>
                                </div>

                            </div>

                            <p>
                                <strong>Status:</strong>

                                @if (job.Status == "Active")
                                {
                                    <span class="badge bg-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Closed
                                    </span>
                                }
                            </p>

                            @if (job.RemainingVacancies <= 0)
                            {
                                <div class="alert alert-warning py-2">
                                    All vacancies have been filled.
                                </div>
                            }

                            <div class="mt-3 d-flex flex-wrap gap-2">

                                <a asp-controller="Employer"
                                   asp-action="EditJob"
                                   asp-route-id="@job.JobId"
                                   class="btn btn-primary">
                                    Edit
                                </a>

                                <a asp-controller="Employer"
                                   asp-action="DeleteJob"
                                   asp-route-id="@job.JobId"
                                   class="btn btn-danger"
                                   onclick="return confirm('Are you sure you want to delete this job?');">
                                    Delete
                                </a>

                                @if (job.Status == "Active")
                                {
                                    <a asp-controller="Employer"
                                       asp-action="CloseJob"
                                       asp-route-id="@job.JobId"
                                       class="btn btn-secondary"
                                       onclick="return confirm('Are you sure you want to close this job?');">
                                        Close Job
                                    </a>
                                }

                            </div>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

    <div class="mt-3 mb-4">
        <a asp-controller="Employer"
           asp-action="Dashboard"
           class="btn btn-secondary">
            ← Back to Dashboard
        </a>
    </div>

</div>