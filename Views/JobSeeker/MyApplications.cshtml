@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "My Applications";
    var applications = Model?.ToList() ?? new List<dynamic>();
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>My Applications</h2>
            <p class="text-muted">
                Track your submitted job applications and their status.
            </p>
        </div>

        <a asp-controller="JobSeeker"
           asp-action="Dashboard"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!applications.Any())
    {
        <div class="alert alert-info">
            You have not applied for any jobs yet.

            <a asp-controller="JobSeeker"
               asp-action="BrowseJobs">
                Browse jobs
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var application in applications)
            {
                <div class="col-md-6">

                    <div class="card shadow h-100">

                        <div class="card-header bg-primary text-white">
                            <h4 class="mb-0">
                                @application.JobTitle
                            </h4>

                            <small>
                                @application.CompanyName
                            </small>
                        </div>

                        <div class="card-body">

                            <p>
                                <strong>Location:</strong>
                                @application.Location
                            </p>

                            <p>
                                <strong>Job Type:</strong>
                                @application.JobType
                            </p>

                            <p>
                                <strong>Salary:</strong>
                                @application.Salary
                            </p>

                            <hr />

                            <h5>Vacancy Information</h5>

                            <p>
                                <strong>Total Vacancies:</strong>
                                @application.TotalVacancies
                            </p>

                            <p>
                                <strong>Filled Vacancies:</strong>
                                @application.FilledVacancies
                            </p>

                            <p>
                                <strong>Remaining Vacancies:</strong>
                                @application.RemainingVacancies
                            </p>

                            <hr />

                            <p>
                                <strong>Applied On:</strong>
                                @application.AppliedDate.ToString("dd-MM-yyyy")
                            </p>

                            <p>
                                <strong>Your Message:</strong>
                                @application.CoverMessage
                            </p>

                            <p>
                                <strong>Status:</strong>

                                @if (application.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                                else if (application.Status == "Accepted")
                                {
                                    <span class="badge bg-success">
                                        Accepted
                                    </span>
                                }
                                else if (application.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @application.Status
                                    </span>
                                }
                            </p>

                            <a asp-controller="JobSeeker"
                               asp-action="JobDetails"
                               asp-route-id="@application.JobId"
                               class="btn btn-outline-primary mt-2">
                                View Job Details
                            </a>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div>
