@model LocalJobPortal.Models.JobApplicationViewModel

@{
    ViewData["Title"] = "Apply for Job";
}

<div class="container mt-5">

    <div class="row justify-content-center">
        <div class="col-md-8">

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            <div class="card shadow">

                <div class="card-header bg-success text-white">
                    <h3 class="mb-0">Apply for Job</h3>
                </div>

                <div class="card-body">

                    <h4>@Model.JobTitle</h4>

                    <p class="text-muted">
                        Complete the form below to submit your application.
                    </p>

                    <hr />

                    <form asp-controller="JobSeeker"
                          asp-action="ApplyJob"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="JobId" />
                        <input type="hidden" asp-for="JobTitle" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="CoverMessage"
                                   class="form-label">
                                Cover Message
                            </label>

                            <textarea asp-for="CoverMessage"
                                      class="form-control"
                                      rows="6"
                                      placeholder="Explain briefly why you are suitable for this job..."></textarea>

                            <span asp-validation-for="CoverMessage"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="alert alert-info">
                            Your application will be submitted as Pending.
                            Applying does not reduce the vacancy count.
                            Vacancies are updated when the employer accepts
                            an application.
                        </div>

                        <div class="d-flex flex-wrap gap-2">

                            <button type="submit"
                                    class="btn btn-success">
                                Submit Application
                            </button>

                            <a asp-controller="JobSeeker"
                               asp-action="JobDetails"
                               asp-route-id="@Model.JobId"
                               class="btn btn-secondary">
                                Back to Job Details
                            </a>

                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
