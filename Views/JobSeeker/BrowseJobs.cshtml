@model IEnumerable<LocalJobPortal.Models.Job>

@{
    ViewData["Title"] = "Browse Jobs";
    var jobs = Model?.ToList() ?? new List<LocalJobPortal.Models.Job>();
}

<div class="container mt-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Available Jobs</h2>
            <p class="text-muted">
                Browse local job opportunities and check vacancy availability.
            </p>
        </div>

        <a asp-controller="JobSeeker"
           asp-action="Dashboard"
           class="btn btn-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!jobs.Any())
    {
        <div class="alert alert-info">
            No active job postings are currently available.
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var job in jobs)
            {
                var matchingJobs = jobs
                    .Where(j => string.Equals(
                        j.JobTitle?.Trim(),
                        job.JobTitle?.Trim(),
                        StringComparison.OrdinalIgnoreCase))
                    .ToList();

                var combinedTotal = matchingJobs.Sum(j => j.TotalVacancies);

                var combinedFilled = matchingJobs.Sum(j => j.FilledVacancies);

                var combinedRemaining = matchingJobs.Sum(
                    j => Math.Max(0, j.TotalVacancies - j.FilledVacancies));

                var remaining = Math.Max(
                    0, job.TotalVacancies - job.FilledVacancies);

                <div class="col-md-6">

                    <div class="card shadow h-100">

                        <div class="card-header bg-primary text-white">
                            <h4 class="mb-0">@job.JobTitle</h4>
                        </div>

                        <div class="card-body">

                            <p>
                                <strong>Employer ID:</strong>
                                @job.EmployerId
                            </p>

                            <p>
                                <strong>Location:</strong>
                                @job.Location
                            </p>

                            <p>
                                <strong>Job Type:</strong>
                                @job.JobType
                            </p>

                            <p>
                                <strong>Salary:</strong>
                                @job.Salary
                            </p>

                            <p>
                                <strong>Required Skills:</strong>
                                @job.RequiredSkills
                            </p>

                            <p>
                                <strong>Description:</strong>
                                @job.JobDescription
                            </p>

                            <hr />

                            <h5>Company's Vacancy Details</h5>

                            <div class="row text-center g-2 mb-3">

                                <div class="col-4">
                                    <div class="border rounded p-2 h-100">
                                        <h4 class="text-primary">
                                            @job.TotalVacancies
                                        </h4>
                                        <small>Total</small>
                                    </div>
                                </div>

                                <div class="col-4">
                                    <div class="border rounded p-2 h-100">
                                        <h4 class="text-warning">
                                            @job.FilledVacancies
                                        </h4>
                                        <small>Filled</small>
                                    </div>
                                </div>

                                <div class="col-4">
                                    <div class="border rounded p-2 h-100">
                                        <h4 class="@(remaining > 0 ? "text-success" : "text-danger")">
                                            @remaining
                                        </h4>
                                        <small>Remaining</small>
                                    </div>
                                </div>

                            </div>

                            @if (matchingJobs.Count > 1)
                            {
                                <div class="alert alert-info">
                                    <strong>Combined vacancies for "@job.JobTitle"</strong>
                                    <hr class="my-2" />

                                    <p class="mb-1">
                                        Total vacancies:
                                        <strong>@combinedTotal</strong>
                                    </p>

                                    <p class="mb-1">
                                        Filled vacancies:
                                        <strong>@combinedFilled</strong>
                                    </p>

                                    <p class="mb-0">
                                        Remaining vacancies:
                                        <strong>@combinedRemaining</strong>
                                    </p>

                                    <small class="d-block mt-2">
                                        Across @matchingJobs.Count matching job postings.
                                        Each employer's listing remains separate.
                                    </small>
                                </div>
                            }

                            @if (remaining <= 0)
                            {
                                <div class="alert alert-warning">
                                    No vacancies remain for this company's
                                    job posting.
                                </div>
                            }

                            <div class="d-flex flex-wrap gap-2 mt-3">

                                <a asp-controller="JobSeeker"
                                   asp-action="JobDetails"
                                   asp-route-id="@job.JobId"
                                   class="btn btn-outline-primary">
                                    View Details
                                </a>

                                @if (job.Status == "Active" && remaining > 0)
                                {
                                    <a asp-controller="JobSeeker"
                                       asp-action="ApplyJob"
                                       asp-route-id="@job.JobId"
                                       class="btn btn-success">
                                        Apply Now
                                    </a>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-secondary"
                                            disabled>
                                        Applications Closed
                                    </button>
                                }

                            </div>

                        </div>
                    </div>
                </div>
            }

        </div>
    }

</div>
